#!/bin/sh

DAEMON=/usr/bin/waybeam
LOADER=/usr/bin/load-cv610-online
NAME=waybeam
RESPAWN=waybeam-resp
WATCHDOG=waybeam-wd
PIDFILE=/var/run/$NAME.pid
# Keep a privileged daemon's redirect outside world-writable /tmp.  OpenIPC
# maps /var/log back to /tmp, while /var/run maps to root-owned /run.  The
# respawn helper uses the same backend-specific path.
LOGFILE=/var/run/$NAME.log
PLATFORM_CONFIG=/etc/waybeam-cv610.conf

WAYBEAM_ENABLED=1
# Sensor clock the modules load with.  Fallback only: the daemon sets the
# clock for the selected mode at bring-up via sns0_clk_hz, so this matters
# solely against a sys_config too old to expose that parameter, where it must
# match video0.fps (sc4336p = 27 MHz for 100 fps, imx662 = 37.125 MHz for
# 30/60/90).  It names a clock profile, not the sensor -- that is an IMX662.
CV610_SENSOR_PROFILE=sc4336p
CV610_AUDIO=0
# The platform override is target-local by design.
# shellcheck disable=SC1090
[ -r "$PLATFORM_CONFIG" ] && . "$PLATFORM_CONFIG"

# API restart forks a short-lived waybeam-resp helper and the successor gets
# a new PID. The pidfile therefore identifies only the original launch and
# must never be used as proof that the graph is idle before unloading modules.
still_running()
{
	pidof "$NAME" "$RESPAWN" "$WATCHDOG" >/dev/null 2>&1
}

# Foreign holders of an MPP device, ignoring the venc family. The check itself
# lives in the loader, next to the rmmod it protects -- see the comment there
# for why unloading under a live consumer wedges the SoC. This wrapper exists
# only so stop() can refuse *before* it kills anything.
#
# rcK already gets the ordering right, because "ls -r" runs S97waybeam-hub stop
# before S95waybeam -- the only reason a reboot has always been safe here while
# a bare "stop" was not.
mpp_holders()
{
	"$LOADER" holders "$(pidof "$NAME" "$RESPAWN" "$WATCHDOG" 2>/dev/null)"
}

start()
{
	if [ "$WAYBEAM_ENABLED" != "1" ]; then
		echo "$NAME disabled by configuration"
		return 0
	fi
	if still_running; then
		echo "$NAME already running"
		return 0
	fi
	if [ -r "$PIDFILE" ]; then
		rm -f "$PIDFILE"
	fi
	CV610_SENSOR_PROFILE="$CV610_SENSOR_PROFILE" \
		CV610_AUDIO="$CV610_AUDIO" "$LOADER" start || return 1
	: >"$LOGFILE"
	start-stop-daemon -S -m -q -p "$PIDFILE" -x "$DAEMON" -- \
		>>"$LOGFILE" 2>&1 &
	sleep 2
	if ! still_running; then
		echo "$NAME failed to start" >&2
		cat "$LOGFILE" >&2
		rm -f "$PIDFILE"
		"$LOADER" stop
		return 1
	fi
	echo "Started $NAME (sensor profile $CV610_SENSOR_PROFILE, audio $CV610_AUDIO)"
}

stop()
{
	# Check for foreign holders before killing anything, so a refusal leaves
	# the device streaming rather than half torn down -- venc dead with the
	# modules still loaded is a state "$LOADER" start then refuses as dirty.
	# Fail closed when the query itself fails. A loader predating the "holders"
	# subcommand exits non-zero with empty stdout, which would otherwise read as
	# "no holders" and hand back the very wedge this guards -- and a partially
	# deployed pair (new init script, old loader) is exactly how that happens.
	if ! holders=$(mpp_holders); then
		echo "cannot query MPP holders via $LOADER -- refusing to unload" >&2
		return 1
	fi
	if [ -n "$holders" ]; then
		echo "refusing to unload CV610 modules: MPP devices still open by $holders" >&2
		echo "stop those consumers first, e.g. /etc/init.d/S97waybeam-hub stop" >&2
		return 1
	fi

	# Cover the current daemon plus either side of an API-respawn handoff.
	# Never unload the MPP stack while any of them still owns the graph.
	killall "$NAME" "$RESPAWN" "$WATCHDOG" 2>/dev/null || true
	i=0
	while still_running && [ "$i" -lt 100 ]; do
		sleep 0.1
		i=$((i + 1))
	done
	if still_running; then
		echo "$NAME did not stop within 10 seconds" >&2
		echo "refusing to unload CV610 modules while the graph is owned" >&2
		return 1
	fi
	rm -f "$PIDFILE"
	"$LOADER" stop
	echo "Stopped $NAME"
}

case "${1:-}" in
	start|stop) "$1" ;;
	restart) stop && start ;;
	*) echo "Usage: $0 {start|stop|restart}" >&2; exit 1 ;;
esac
