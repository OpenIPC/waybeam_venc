#!/bin/sh

DAEMON=/usr/bin/waybeam
LOADER=/usr/bin/load-cv610-online
NAME=waybeam
RESPAWN=waybeam-resp
WATCHDOG=waybeam-wd
PIDFILE=/var/run/$NAME.pid
# Keep a privileged daemon's redirect outside world-writable /tmp.  OpenIPC
# maps /var/log back to /tmp, while /var/run maps to root-owned /run.  The
# respawn helper uses the same backend-specific path.
LOGFILE=/var/run/$NAME.log
PLATFORM_CONFIG=/etc/waybeam-cv610.conf

WAYBEAM_ENABLED=1
# Sensor clock the modules load with.  Fallback only: the daemon sets the
# clock for the selected mode at bring-up via sns0_clk_hz, so this matters
# solely against a sys_config too old to expose that parameter, where it must
# match video0.fps (sc4336p = 27 MHz for 100 fps, imx662 = 37.125 MHz for
# 30/60/90).  It names a clock profile, not the sensor -- that is an IMX662.
CV610_SENSOR_PROFILE=sc4336p
CV610_AUDIO=0
# The platform override is target-local by design.
# shellcheck disable=SC1090
[ -r "$PLATFORM_CONFIG" ] && . "$PLATFORM_CONFIG"

# API restart forks a short-lived waybeam-resp helper and the successor gets
# a new PID. The pidfile therefore identifies only the original launch and
# must never be used as proof that the graph is idle before unloading modules.
still_running()
{
	pidof "$NAME" "$RESPAWN" "$WATCHDOG" >/dev/null 2>&1
}

start()
{
	if [ "$WAYBEAM_ENABLED" != "1" ]; then
		echo "$NAME disabled by configuration"
		return 0
	fi
	if still_running; then
		echo "$NAME already running"
		return 0
	fi
	if [ -r "$PIDFILE" ]; then
		rm -f "$PIDFILE"
	fi
	CV610_SENSOR_PROFILE="$CV610_SENSOR_PROFILE" \
		CV610_AUDIO="$CV610_AUDIO" "$LOADER" start || return 1
	: >"$LOGFILE"
	start-stop-daemon -S -m -q -p "$PIDFILE" -x "$DAEMON" -- \
		>>"$LOGFILE" 2>&1 &
	sleep 2
	if ! still_running; then
		echo "$NAME failed to start" >&2
		cat "$LOGFILE" >&2
		rm -f "$PIDFILE"
		"$LOADER" stop
		return 1
	fi
	echo "Started $NAME (sensor profile $CV610_SENSOR_PROFILE, audio $CV610_AUDIO)"
}

stop()
{
	# Cover the current daemon plus either side of an API-respawn handoff.
	killall "$NAME" "$RESPAWN" "$WATCHDOG" 2>/dev/null || true
	i=0
	while still_running && [ "$i" -lt 100 ]; do
		sleep 0.1
		i=$((i + 1))
	done
	if still_running; then
		echo "$NAME did not stop within 10 seconds" >&2
		return 1
	fi
	rm -f "$PIDFILE"
	# The MPP modules stay loaded, the way they do on star6e and maruko. venc
	# tears its own graph down in mpp_cleanup() -- including vb_exit() from the
	# process that created it, which is the only process allowed to -- so the
	# next start re-inits against the modules already up. Unloading them here
	# was bring-up scaffolding, and it is what wedged the SoC whenever a
	# consumer still held one of their devices.
	echo "Stopped $NAME (MPP modules left loaded)"
}

# Recovery: after a venc that died without running mpp_cleanup(), VB is held by
# a dead owner and the next start refuses if the mode's pool layout differs.
# This is the way out. It unloads, so the loader's holder check applies -- stop
# waybeam_hub first.
reload()
{
	stop || return 1
	# Pass the same profile start() does. A bare "$LOADER" restart reloads with
	# the loader's own defaults -- video-only, imx662 clock -- and then start()
	# refuses the audio mismatch, so the craft comes back with no daemon at all.
	CV610_SENSOR_PROFILE="$CV610_SENSOR_PROFILE" \
		CV610_AUDIO="$CV610_AUDIO" "$LOADER" restart || return 1
	start
}

case "${1:-}" in
	start|stop|reload) "$1" ;;
	restart) stop && start ;;
	*) echo "Usage: $0 {start|stop|restart|reload}" >&2; exit 1 ;;
esac
